# Copiar a .env (cp .env.example .env). El archivo .env NO se sube a GitHub.

# Base de datos PostgreSQL (local con Docker o AWS RDS)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blacklist

# Clave para firmar el Bearer Token (JWT). Cambiarla en AWS.
JWT_SECRET_KEY=cambiar-por-una-clave-segura

# Nivel de logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Proxies delante de la app: 1 en local/Docker, 2 en Beanstalk (ALB + Nginx)
PROXY_FIX_X_FOR=1

# New Relic (solo aplica al correr con Docker). La licencia es la clave "INGEST - LICENSE".
NEW_RELIC_LICENSE_KEY=cambiar-por-la-licencia
NEW_RELIC_APP_NAME=blacklist-service-dev
NEW_RELIC_LOG=stdout
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=true
