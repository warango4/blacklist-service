{
  "family": "blacklist-service",
  "executionRoleArn": "arn:aws:iam::382653158215:role/blacklist-ecs-task-execution",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "blacklist-service",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "DB_HOST", "value": "blacklist-db.cu748uikgy9x.us-east-1.rds.amazonaws.com" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "blacklist" },
        { "name": "DB_USER", "value": "postgres" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "PROXY_FIX_X_FOR", "value": "1" },
        { "name": "NEW_RELIC_APP_NAME", "value": "blacklist-service-prod" },
        { "name": "NEW_RELIC_LOG", "value": "stdout" },
        { "name": "NEW_RELIC_DISTRIBUTED_TRACING_ENABLED", "value": "true" },
        { "name": "NEW_RELIC_APPLICATION_LOGGING_ENABLED", "value": "true" },
        { "name": "NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED", "value": "true" }
      ],
      "secrets": [
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:382653158215:secret:blacklist/db-password" },
        { "name": "JWT_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:382653158215:secret:blacklist/jwt-secret-key" },
        { "name": "NEW_RELIC_LICENSE_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:382653158215:secret:blacklist/newrelic-license-key" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/blacklist-service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
